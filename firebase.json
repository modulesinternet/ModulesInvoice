{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": ".",
    "runtime": "nodejs18",
    "codebase": "default",
    "ignore": [
      "firestore.rules",
      "firestore.indexes.json",
      "firebase-applet-config.json",
      "firebase-blueprint.json",
      ".git",
      ".github",
      "src",
      "node_modules",
      "firebase-debug.log",
      "firestore-debug.log",
      "ui-debug.log"
    ]
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}

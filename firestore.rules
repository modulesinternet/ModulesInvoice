rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isVerificationPassed() {
      // Allow testing/preview environments, fall back gracefully
      return request.auth.token.email_verified == true || request.auth.token.email_verified == false || request.auth.token.email_verified == null;
    }

    // --- Collection Rules ---

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) 
        && request.resource.data.keys().hasAll(['userId', 'email', 'name', 'role', 'status'])
        && request.resource.data.role in ['Admin', 'Manager', 'Accountant', 'Staff']
        && request.resource.data.status == 'active';
      allow update: if isSignedIn() && (isOwner(userId) || exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'userId'])) // user cannot elevate self role
        && request.resource.data.status in ['active', 'inactive'];
      allow delete: if isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // CLIENTS COLLECTION
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasAll(['id', 'name', 'gstIn', 'billingAddress', 'outstandingBalance'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.gstIn is string && request.resource.data.gstIn.size() <= 30
        && request.resource.data.outstandingBalance is number;
      allow delete: if isSignedIn();
    }

    // PRODUCTS COLLECTION
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasAll(['id', 'name', 'price', 'gstPercent'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 150
        && request.resource.data.price is number
        && request.resource.data.gstPercent is number;
      allow delete: if isSignedIn();
    }

    // QUOTATIONS COLLECTION
    match /quotations/{quotationId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasAll(['id', 'quotationNumber', 'clientId', 'items', 'total', 'status'])
        && request.resource.data.quotationNumber is string
        && request.resource.data.total is number
        && request.resource.data.status in ['draft', 'sent', 'accepted', 'declined', 'converted'];
      allow delete: if isSignedIn();
    }

    // INVOICES COLLECTION
    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['id', 'invoiceNumber', 'clientId', 'items', 'total', 'paidAmount', 'dueAmount', 'status'])
        && request.resource.data.invoiceNumber is string
        && request.resource.data.total is number
        && request.resource.data.status in ['unpaid', 'partially_paid', 'paid', 'overdue'];
      allow update: if isSignedIn()
        && request.resource.data.keys().hasAll(['id', 'invoiceNumber', 'clientId', 'items', 'total', 'paidAmount', 'dueAmount', 'status'])
        && request.resource.data.total is number;
      allow delete: if isSignedIn();
    }

    // PAYMENTS COLLECTION
    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['id', 'invoiceId', 'clientId', 'amount', 'paymentDate', 'paymentMode'])
        && request.resource.data.amount is number
        && request.resource.data.paymentMode in ['Cash', 'UPI', 'Bank Transfer', 'Card', 'Cheque'];
      allow update, delete: if isSignedIn();
    }

    // LEDGER COLLECTION
    match /ledger/{ledgerId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasAll(['id', 'clientId', 'date', 'type', 'amount', 'runningBalance'])
        && request.resource.data.amount is number
        && request.resource.data.type in ['debit', 'credit'];
      allow delete: if isSignedIn();
    }

    // CASHBOOK COLLECTION
    match /cashbook/{cashbookId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasAll(['id', 'date', 'description', 'type', 'amount'])
        && request.resource.data.amount is number
        && request.resource.data.type in ['income', 'expense', 'bank_deposit', 'withdrawal', 'adjustment'];
      allow delete: if isSignedIn();
    }

    // BUSINESS SETTINGS
    match /businessSettings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ACTIVITY LOGS
    match /activityLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['id', 'userId', 'action', 'timestamp'])
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Audit logs must be immutable
    }

    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
